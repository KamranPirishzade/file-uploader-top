<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { pageTitle: 'Rename folder' }) %>
  </head>
  <body>
    <%- include('partials/header') %>

    <main class="page-narrow">
      <div class="mb-6">
        <h1 class="page-title">Rename folder</h1>
        <p class="page-subtitle wrap-anywhere">Current name: <%= folder.name %></p>
      </div>

      <form method="POST" action="/folders/<%= folder.id %>/edit" class="form-card">
        <%- include('partials/errors', { errors: errors }) %>
        <div class="field">
          <label for="folderName" class="field-label">New name</label>
          <input
            type="text"
            id="folderName"
            name="folderName"
            class="field-input"
            value="<%= data.folderName ?? folder.name %>"
            maxlength="100"
            required
            autofocus
          />
        </div>
        <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
          <a href="/folders/<%= folder.id %>" class="btn btn-secondary">Cancel</a>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </main>
  </body>
</html>
