<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Folder</title>
  </head>
  <body>
    <h1>Edit Folder</h1>
    <p>You are editing the folder: <%= folder.name %></p>
    <form method="POST" action="/folders/<%= folder.id %>/edit">
      <%- include('partials/errors', { errors: errors }) %>
      <label for="folderName">Folder Name:</label>
      <input
        type="text"
        id="folderName"
        name="folderName"
        value="<%= data.folderName ?? folder.name %>"
        required
      />
      <button type="submit">Update Folder</button>
    </form>
  </body>
</html>
