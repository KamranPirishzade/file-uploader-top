<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { pageTitle: file.originalName }) %>
  </head>
  <body>
    <%- include('partials/header') %>

    <main class="page">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">My Drive</a>
        <span aria-hidden="true">/</span>
        <a href="/folders/<%= file.folderId %>">Back to folder</a>
      </nav>

      <div class="mb-6 flex items-start gap-3">
        <span class="item-icon item-icon-file size-11"><%- include('partials/fileIcon') %></span>
        <h1 class="page-title min-w-0"><%= file.originalName %></h1>
      </div>

      <div class="card mb-6">
        <dl class="details">
          <div class="details-row">
            <dt class="details-label">Size</dt>
            <dd class="details-value"><%= bytesToSize(file.size) %></dd>
          </div>
          <div class="details-row">
            <dt class="details-label">Type</dt>
            <dd class="details-value"><%= fileTypeLabel(file.mimeType) %></dd>
          </div>
          <div class="details-row">
            <dt class="details-label">Uploaded</dt>
            <dd class="details-value">
              <%= formatDate(file.createdAt) %>, <%= file.createdAt.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" }) %>
            </dd>
          </div>
        </dl>
      </div>

      <div class="flex flex-col gap-2 sm:flex-row">
        <a href="/files/<%= file.id %>/download" class="btn btn-primary">Download</a>
        <form
          action="/files/<%= file.id %>/delete"
          method="POST"
          onsubmit="return confirm('Delete this file? This cannot be undone.');"
        >
          <button type="submit" class="btn btn-danger w-full sm:w-auto">Delete file</button>
        </form>
      </div>
    </main>
  </body>
</html>
