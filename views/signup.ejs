<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign Up</title>
  </head>
  <body>
    <h1>Sign Up</h1>
    <p>Welcome to the Sign Up page</p>
    <%- include('partials/errors', { errors: errors }) %>
    <form method="POST" action="/signup">
      <label for="name">Name:</label>
      <input type="text" id="name" name="name" value="<%= data.name %>" required /><br />
      <label for="surname">Surname:</label>
      <input type="text" id="surname" name="surname" value="<%= data.surname %>" required /><br />
      <label for="email">Email:</label>
      <input type="email" id="email" name="email" value="<%= data.email %>" required /><br />
      <label for="password">Password:</label>
      <input type="password" id="password" name="password" required /><br />
      <button type="submit">Sign Up</button>
    </form>
  </body>
</html>
