<% if (errors && errors.length > 0) { %>
  <div role="alert">
    <% if (errors.length === 1) { %>
      <p><%= errors[0].msg %></p>
    <% } else { %>
      <p>Please fix the following:</p>
      <ul>
        <% errors.forEach((error) => { %>
          <li><%= error.msg %></li>
        <% }); %>
      </ul>
    <% } %>
  </div>
<% } %>