<% folders.forEach(function (folder) { %>
  <li class="item">
    <span class="item-icon item-icon-folder"><%- include('partials/folderIcon') %></span>
    <div class="item-main">
      <a href="/folders/<%= folder.id %>" class="item-name"><%= folder.name %></a>
      <p class="item-meta">Created <%= formatDate(folder.createdAt) %></p>
    </div>
    <div class="item-actions">
      <a href="/folders/<%= folder.id %>/edit" class="btn-ghost">Rename</a>
      <form
        action="/folders/<%= folder.id %>/delete"
        method="POST"
        onsubmit="return confirm('Delete this folder and all of its files?');"
      >
        <button type="submit" class="btn-ghost-danger">Delete</button>
      </form>
    </div>
  </li>
<% }); %>
