<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Folder <%= folder.name %></title>
  </head>
  <body>
    <h1>Folder: <%= folder.name %></h1>
    <p>Folder ID: <%= folder.id %></p>
    <p>Created At: <%= folder.createdAt.toLocaleString() %></p>
    <a href="/folders/<%= folder.id %>/edit">Edit Folder</a>
    <form
      action="/folders/<%= folder.id %>/delete"
      method="POST"
      onsubmit="return confirm('Are you sure you want to delete this folder?');"
    >
      <button type="submit">Delete Folder</button>
    </form>
    <form
      action="/folders/<%= folder.id %>/upload"
      method="POST"
      enctype="multipart/form-data"
    >
    <%- include('partials/errors', { errors: errors }) %>
      <input type="file" name="file" />
      <button type="submit">Upload File</button>
    </form>
    <% if(files.length === 0) { %>
      <p>No files in this folder.</p>
    <% } else { %>
      <h2>Files in this folder:</h2>
      <ul>
        <% files.forEach(file => { %>
          <li>
            <a href="/files/<%= file.id %>"><%= file.originalName %></a>
            <span>Size: <%= bytesToSize(file.size) %></span>
            (Uploaded at: <%= file.createdAt.toLocaleString() %>)
          </li>
        <% }) %>
      </ul>
    <% } %> 

  </body>
</html>
