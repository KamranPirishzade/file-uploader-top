<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { pageTitle: currentUser ? 'My Drive' : 'Home' }) %>
  </head>
  <body>
    <%- include('partials/header') %>

    <% if (currentUser) { %>
      <main class="page">
        <div class="mb-6">
          <h1 class="page-title">My Drive</h1>
          <p class="page-subtitle">Create folders, upload files and share them with a link.</p>
        </div>

        <form method="POST" action="/folders/create" class="card mb-8 flex flex-col gap-3 p-4">
          <label for="folderName" class="field-label">New folder</label>
          <%- include('partials/errors', { errors: errors }) %>
          <div class="inline-form">
            <input
              type="text"
              id="folderName"
              name="folderName"
              class="field-input"
              placeholder="e.g. University"
              value="<%= data.folderName ?? '' %>"
              maxlength="100"
              required
            />
            <button type="submit" class="btn btn-primary">Create folder</button>
          </div>
        </form>

        <h2 class="section-title">Folders</h2>
        <% if (folders.length === 0) { %>
          <div class="empty-state">
            <p class="font-medium text-gray-900">No folders yet</p>
            <p class="mt-1 text-sm text-gray-500">Create your first folder above to start uploading files.</p>
          </div>
        <% } else { %>
          <ul class="item-list">
            <%- include('folders', { folders: folders }) %>
          </ul>
        <% } %>
      </main>
    <% } else { %>
      <main class="mx-auto flex w-full max-w-3xl flex-col items-center px-4 py-16 text-center sm:py-24">
        <span class="card mb-6 p-3"><img src="/logo.png" alt="" width="56" height="56" class="size-14" /></span>
        <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl">Your files, in one place</h1>
        <p class="mt-3 max-w-md text-gray-600">
          Organise files into folders, download them anywhere and share a folder with anyone using a link that expires.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/signup" class="btn btn-primary px-5 py-2.5">Create an account</a>
          <a href="/login" class="btn btn-secondary px-5 py-2.5">Log in</a>
        </div>

        <ul class="mt-14 grid w-full gap-3 text-left sm:grid-cols-3">
          <li class="card p-4">
            <p class="font-semibold text-gray-900">Folders</p>
            <p class="mt-1 text-sm text-gray-500">Keep files organised the way you like.</p>
          </li>
          <li class="card p-4">
            <p class="font-semibold text-gray-900">Uploads</p>
            <p class="mt-1 text-sm text-gray-500">Images, PDFs and Office files up to 10 MB.</p>
          </li>
          <li class="card p-4">
            <p class="font-semibold text-gray-900">Share links</p>
            <p class="mt-1 text-sm text-gray-500">Share a folder for 1, 7 or 30 days.</p>
          </li>
        </ul>
      </main>
    <% } %>
  </body>
</html>
